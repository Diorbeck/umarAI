# === Telegram ===
# Токен бота от @BotFather. НИКОГДА не коммитить реальный токен.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Секрет, который Telegram присылает в заголовке X-Telegram-Bot-Api-Secret-Token.
# Сгенерируйте: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me
# Telegram ID владельца(ев) через запятую. Узнать свой ID: @userinfobot
TELEGRAM_ALLOWED_USER_IDS=123456789

# === Claude ===
ANTHROPIC_API_KEY=sk-ant-...

# === PostgreSQL (Railway подставит свой DATABASE_URL) ===
DATABASE_URL=postgres://user:pass@localhost:5432/umar

# === Markdown-память (позже подключается к Obsidian) ===
OBSIDIAN_VAULT_PATH=./vault

# === Сервер ===
PORT=3000
NODE_ENV=development

# === Ограничения контекста ===
CONTEXT_MAX_MESSAGES=30
CONTEXT_MAX_CHARS=24000
